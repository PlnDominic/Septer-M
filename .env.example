# ---- API (apps/api) -------------------------------------------------------
# Supabase > Project Settings > API. The service role key bypasses all security
# rules: keep it server-side only (Vercel env vars), never commit it or expose it
# to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Protects scheduled-job endpoints. Any long random string (16+ characters).
CRON_SECRET=
# Allowed browser origins for CORS, comma separated (e.g. https://septer-m.vercel.app)
WEB_ORIGIN=http://localhost:3000

# ---- Web (apps/web) -------------------------------------------------------
# The public address of the site (no trailing slash). Used for the sitemap, social previews and Google product data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Safe to expose: these only allow what Row Level Security permits.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Business details (shown on the Contact page, footer and legal pages) ------
# Leave any of these empty and it simply isn't shown. Fill them in before launch.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Digits only, with country code, e.g. 233241234567
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SUPPORT_HOURS=
# Registered company details (UK law expects these on a shop's website)
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_VAT_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ---- Payments (added in the payments phase) ---------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
