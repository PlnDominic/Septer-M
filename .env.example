# ---- API (apps/api) -------------------------------------------------------
# Supabase > Project Settings > API. The service role key bypasses all security
# rules: keep it server-side only (Vercel env vars), never commit it or expose it
# to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Protects scheduled-job endpoints. Any long random string (16+ characters).
CRON_SECRET=
# Allowed browser origins for CORS, comma separated (e.g. https://septer-m.vercel.app)
WEB_ORIGIN=http://localhost:3000

# ---- Web (apps/web) -------------------------------------------------------
# The public address of the site (no trailing slash). Used for the sitemap, social previews and Google product data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Safe to expose: these only allow what Row Level Security permits.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Business details (shown on the Contact page, footer and legal pages) ------
# Leave any of these empty and it simply isn't shown. Fill them in before launch.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Digits only, with country code, e.g. 233241234567
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SUPPORT_HOURS=
# Registered company details (UK law expects these on a shop's website)
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_VAT_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ---- Public address of the API, as the browser sees it (no trailing slash) ----------
# Leave NEXT_PUBLIC_API_URL empty and the storefront and admin run in browser-only demo mode.
# (It is set above in the Web section.)

# ---- Payments (API) -----------------------------------------------------------
# The public address of the storefront. Payment return links and the links in emails are built from it.
WEB_URL=http://localhost:3000
# Stripe (UK cards, Apple Pay, Google Pay): Developers > API keys, and Developers > Webhooks.
# Webhook endpoint: https://YOUR-API/v1/webhooks/stripe  (event: checkout.session.completed and checkout.session.async_payment_succeeded)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Paystack (Ghana cards and Mobile Money): Settings > API Keys & Webhooks.
# Webhook URL: https://YOUR-API/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=

# ---- Email (API) --------------------------------------------------------------
# Resend (resend.com). EMAIL_FROM must be on a domain you have verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Septer-M <orders@your-domain.com>"
